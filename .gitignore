# Third-party code, binaries, models and data are pinned in third_party/manifest.json
# and fetched by tools/setup.py -- never committed.
third_party/*
!third_party/manifest.json
godot/models
godot/data/pron_dict.txt
stt-eval/models
stt-eval/data
stt-eval/.venv
# Personal voice recordings (e.g. your kids) never leave your machine
stt-eval/recordings
stt-eval/recordings-trash
stt-eval/recordings-stage
# Reference photos of real people stay local
art/reference/
godot/art/reference/
# Python
__pycache__/
*.pyc
.venv/
# Godot
godot/.godot/
godot/addons/hero_listen/bin/*
!godot/addons/hero_listen/bin/.gitkeep
# Native build outputs
native/**/*.o
native/**/*.os
native/**/*.obj
native/**/.sconsign*.dblite
# Generated by tools/make_tts_clips.ps1
godot/tests/tts_clips/
